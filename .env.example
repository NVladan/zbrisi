# Copy this file to ".env" and fill in your values.
#
# How to get these (free):
#   1. Sign up at https://www.travelpayouts.com/  (it's an affiliate network).
#   2. API token:  Dashboard -> Tools -> API  (or
#      https://www.travelpayouts.com/programs/100/tools/api ).
#   3. Marker (your partner ID): shown in your account / on any affiliate link.
#      This is how Travelpayouts attributes bookings to you and PAYS you the
#      referral commission, so don't leave it blank in production.

# Required for live flight data:
TRAVELPAYOUTS_TOKEN=

# Required to actually earn commission on referrals:
TRAVELPAYOUTS_MARKER=

# Optional tuning:
FLIGHTS_CURRENCY=eur     # default currency (usd, eur, gbp, rsd, chf, aud ...)
FLIGHTS_MARKET=us        # data source market (country code)

# Optional analytics (both off unless set):
#   Plausible is cookieless (loads without consent). GA4 sets cookies and is
#   only loaded after the visitor accepts the cookie banner.
PLAUSIBLE_DOMAIN=        # e.g. zbrisi.com  (your verified Plausible domain)
GA_MEASUREMENT_ID=       # e.g. G-XXXXXXXXXX

# SEO: Google Search Console verification (the content of the meta tag):
GOOGLE_SITE_VERIFICATION=

# Mapbox token for the "Browse on map" page (/map). A public pk.* token, meant
# to ship to the browser. Create one at https://account.mapbox.com/access-tokens/
# with ONLY the public scopes STYLES:TILES, STYLES:READ, FONTS:READ, then add URL
# restrictions so it can't be used off your domain:
#   https://zbrisi.com, https://www.zbrisi.com, http://localhost:5001
# Also set a usage alert in the Mapbox dashboard. If unset, a built-in fallback
# token is used (fine for local dev, but set your own restricted token in prod).
MAPBOX_TOKEN=

# City photos for the destination cards (landing grid + /anywhere explorer).
# Free key at https://www.pexels.com/api/ . With it set, the app fetches a photo
# on demand the first time a new destination appears (and scripts/fetch_city_images.py
# can bulk pre-seed). Without it, cards just use the brand gradient.
PEXELS_API_KEY=
CITY_PHOTO_PACE=1.5      # seconds between on-demand fetches (raise if Pexels 429s)

# Travelpayouts Drive loader (affiliate monetisation + site verification).
# The `src` URL from your Drive "Manual installation" snippet. Empty = off.
TP_DRIVE_SRC=

# Cross-sell partner links on the results page ("complete your trip"). Hotels
# already works (contextual Hotellook with your marker). To show the other
# cards, paste a Travelpayouts "Create link" URL for each partner here:
XSELL_INSURANCE=
XSELL_ESIM=
XSELL_TRANSFERS=
XSELL_HOTELS=     # optional — overrides the default Hotellook hotels link

# Legal / contact (shown in the footer, privacy page and imprint).
# The operator can be a private individual — no company needed. Set your name
# and country before launch. The address is optional (shown only if filled);
# some EU countries expect one for a monetised site, others don't.
CONTACT_EMAIL=
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=

# Social / profile URLs (comma-separated) for the Organization "sameAs" in the
# structured data — helps Google and AI assistants recognise Zbriši as a known
# brand entity. Add the profiles you actually have. Example:
# SOCIAL_LINKS=https://www.instagram.com/zbrisi,https://x.com/zbrisi,https://www.trustpilot.com/review/zbrisi.com
SOCIAL_LINKS=

# Flask:
FLASK_DEBUG=0            # set to 1 only for local development
PORT=5001
